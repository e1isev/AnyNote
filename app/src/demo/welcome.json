{"type":"doc","content":[{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5deac3abe750"},"content":[{"type":"text","text":"AnyNote keeps your notes on this computer, in an open format you can read without it. Here is what a page can hold. Everything on this page can be edited, so try things out."}]},{"type":"heading","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5debf5db9d87","level":2},"content":[{"type":"text","text":"Write the way you like"}]},{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5deca3d925e6"},"content":[{"type":"text","text":"Use the toolbar, or type Markdown shortcuts: "},{"type":"text","text":"#","marks":[{"type":"code"}]},{"type":"text","text":" and a space for a heading, "},{"type":"text","text":"-","marks":[{"type":"code"}]},{"type":"text","text":" for a bullet, "},{"type":"text","text":"1.","marks":[{"type":"code"}]},{"type":"text","text":" for a numbered list, "},{"type":"text","text":"[ ]","marks":[{"type":"code"}]},{"type":"text","text":" for a to-do, "},{"type":"text","text":">","marks":[{"type":"code"}]},{"type":"text","text":" for a quote and three backticks for code. Type "},{"type":"text","text":"/","marks":[{"type":"code"}]},{"type":"text","text":" on an empty line to insert any block."}]},{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5ded0e8f7b0d"},"content":[{"type":"text","text":"Bold","marks":[{"type":"bold"}]},{"type":"text","text":", "},{"type":"text","text":"italic","marks":[{"type":"italic"}]},{"type":"text","text":", "},{"type":"text","text":"underline","marks":[{"type":"underline"}]},{"type":"text","text":", "},{"type":"text","text":"strike","marks":[{"type":"strike"}]},{"type":"text","text":", "},{"type":"text","text":"highlight","marks":[{"type":"highlight"}]},{"type":"text","text":" and "},{"type":"text","text":"inline code","marks":[{"type":"code"}]},{"type":"text","text":" all work as you'd expect."}]},{"type":"heading","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5deef5796c97","level":2},"content":[{"type":"text","text":"Tasks"}]},{"type":"taskList","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5def927e9b9c"},"content":[{"type":"taskItem","attrs":{"checked":false,"id":"01a177d8-0d6f-761a-b8fe-5df0df94d742"},"content":[{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5df1115a340d"},"content":[{"type":"text","text":"Type "},{"type":"text","text":"[ ]","marks":[{"type":"code"}]},{"type":"text","text":" and a space to start a to-do"}]}]},{"type":"taskItem","attrs":{"checked":false,"id":"01a177d8-0d6f-761a-b8fe-5df25aa1c6a9"},"content":[{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5df34b16d655"},"content":[{"type":"text","text":"Open "},{"type":"text","text":"Tasks","marks":[{"type":"bold"}]},{"type":"text","text":" in the sidebar to see every to-do from every notebook"}]}]},{"type":"taskItem","attrs":{"checked":true,"id":"01a177d8-0d6f-761a-b8fe-5df44b0912e4"},"content":[{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5df5a033b130"},"content":[{"type":"text","text":"Tick them off from either place"}]}]}]},{"type":"heading","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5df61f0be72b","level":2},"content":[{"type":"text","text":"Link your thinking"}]},{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5df715601287"},"content":[{"type":"text","text":"Type "},{"type":"text","text":"[[","marks":[{"type":"code"}]},{"type":"text","text":" to link to another page. The page you link to lists this one under "},{"type":"text","text":"Backlinks","marks":[{"type":"bold"}]},{"type":"text","text":". Add #tags anywhere in the text, then browse them under "},{"type":"text","text":"Tags","marks":[{"type":"bold"}]},{"type":"text","text":"."}]},{"type":"heading","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5df80a471894","level":2},"content":[{"type":"text","text":"Math and code"}]},{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5df9b62860dd"},"content":[{"type":"text","text":"Inline math like "},{"type":"inlineMath","attrs":{"latex":"e^{i\\pi} + 1 = 0"}},{"type":"text","text":" sits in the text, and display math gets its own block:"}]},{"type":"blockMath","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5dfaca3e9e11","latex":"\\int_0^1 x^2\\,dx = \\frac{1}{3}"}},{"type":"codeBlock","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5dfb260214db","language":"python"},"content":[{"type":"text","text":"def greet(name: str) -> str:\n    return f\"Hello, {name}!\""}]},{"type":"heading","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5dfc69ca7612","level":2},"content":[{"type":"text","text":"Draw"}]},{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5dfda8104a18"},"content":[{"type":"text","text":"Choose "},{"type":"text","text":"Ink","marks":[{"type":"bold"}]},{"type":"text","text":" in the toolbar, or type "},{"type":"text","text":"/ink","marks":[{"type":"code"}]},{"type":"text","text":", to add a drawing canvas. Pen pressure works with a stylus."}]},{"type":"heading","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5dfe556bf11a","level":2},"content":[{"type":"text","text":"Bring your notes"}]},{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5dfffb753f95"},"content":[{"type":"text","text":"Import \u2192 OneNote","marks":[{"type":"bold"}]},{"type":"text","text":" reads "},{"type":"text","text":".one","marks":[{"type":"code"}]},{"type":"text","text":" sections and "},{"type":"text","text":".onetoc2","marks":[{"type":"code"}]},{"type":"text","text":" notebooks, handwriting included. "},{"type":"text","text":"Import \u2192 Folder","marks":[{"type":"bold"}]},{"type":"text","text":" reads Markdown folders such as Obsidian vaults. "},{"type":"text","text":"Export","marks":[{"type":"bold"}]},{"type":"text","text":" writes everything as Markdown with JSON sidecars, so you can open your notes without AnyNote."}]},{"type":"table","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5e00943c2484"},"content":[{"type":"tableRow","content":[{"type":"tableHeader","content":[{"type":"paragraph","attrs":{"id":"01a177d8-0d6f-761a-b8fe-5e0134bf13d6"},"content":[{"type"